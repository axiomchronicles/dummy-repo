{
  "name": "outreach-intern",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=24.13.0 <25 || >=26.0.0"
  },
  "scripts": {
    "dev:all": "node scripts/dev-all.mjs",
    "dev:ll": "npm run dev:all",
    "dev:api": "node --env-file-if-exists=.env --import tsx --watch apps/api/src/main.ts",
    "dev:worker": "node --env-file-if-exists=.env --import tsx --watch apps/worker/src/main.ts",
    "dev:admin": "node --env-file-if-exists=.env node_modules/vite/bin/vite.js --config apps/admin/vite.config.ts",
    "dev:web": "node --env-file-if-exists=.env node_modules/vite/bin/vite.js --config apps/web/vite.config.ts",
    "dev:mobile": "cd apps/mobile && flutter run",
    "typecheck": "tsc --noEmit",
    "lint": "eslint apps packages tests scripts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "build": "node scripts/build.mjs",
    "start:api": "node dist/api.cjs",
    "start:worker": "node dist/worker.cjs",
    "start:admin": "node scripts/serve-admin.mjs",
    "start:web": "WEB_APP=web node scripts/serve-admin.mjs",
    "db:generate": "node --env-file-if-exists=.env node_modules/drizzle-kit/bin.cjs generate --config packages/database/drizzle.config.ts",
    "db:migrate": "node --env-file-if-exists=.env --import tsx packages/database/src/migrate.ts",
    "db:seed": "node --env-file-if-exists=.env --import tsx packages/database/src/seed.ts",
    "db:setup": "npm run db:migrate && npm run db:seed",
    "test": "vitest run --config vitest.config.ts",
    "test:integration": "node --env-file-if-exists=.env node_modules/vitest/vitest.mjs run --config vitest.integration.config.ts",
    "test:e2e": "node --env-file-if-exists=.env node_modules/@playwright/test/cli.js test",
    "verify": "npm run format:check && npm run lint && npm run typecheck && npm test && npm run build",
    "docs:api": "node --import tsx scripts/generate-openapi.mjs",
    "test:compose-smoke": "node --env-file-if-exists=.env --import tsx scripts/compose-smoke.ts",
    "test:integration:local": "node --env-file-if-exists=.env tests/support/run-integration.mjs",
    "test:e2e:local": "CHAT_WEB_URL=http://localhost:5180 WORKFLOW_WEB_URL=http://localhost:5190 node --env-file-if-exists=.env node_modules/@playwright/test/cli.js test"
  },
  "dependencies": {
    "@ai-sdk/openai-compatible": "^3.0.79",
    "@hookform/resolvers": "5.2.2",
    "@mastra/core": "^1.79.0",
    "@mastra/pg": "^1.32.0",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@nestjs/common": "11.2.8",
    "@nestjs/core": "11.2.8",
    "@nestjs/platform-express": "11.2.8",
    "@tanstack/react-query": "5.104.5",
    "@types/pdf-parse": "^1.1.5",
    "ajv": "^8.20.0",
    "bullmq": "5.81.5",
    "class-variance-authority": "0.7.1",
    "cn": "0.2.4",
    "csv-parse": "7.0.3",
    "drizzle-orm": "0.45.4",
    "exceljs": "4.4.0",
    "ioredis": "5.11.1",
    "libphonenumber-js": "1.13.15",
    "lucide-react": "1.61.0",
    "openai": "^7.45.0",
    "pdf-parse": "^1.1.1",
    "pg": "8.23.1",
    "radix-ui": "1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-hook-form": "7.90.0",
    "react-router-dom": "7.18.4",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "sarvamai": "1.1.12",
    "tw-animate-css": "1.4.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@tailwindcss/vite": "4.3.3",
    "@types/express": "5.0.6",
    "@types/node": "24.10.1",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "drizzle-kit": "0.31.11",
    "esbuild": "0.28.2",
    "eslint": "10.13.0",
    "prettier": "3.9.10",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.0",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  },
  "overrides": {
    "esbuild": "$esbuild",
    "exceljs": {
      "uuid": "11.1.1"
    }
  }
}
