# Local-only defaults. Production rejects DEV_AUTH=true.
NODE_ENV=development
DEV_AUTH=true
PUBLIC_BASE_URL=http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173
API_PORT=3000
WORKER_PORT=3001
WEB_PORT=5173
DATABASE_URL=postgresql://outreach:outreach@localhost:5442/outreach
REDIS_URL=redis://localhost:6389
# Compose overrides database/Redis to container service DNS.
POSTGRES_USER=outreach
POSTGRES_PASSWORD=outreach
POSTGRES_DB=outreach
POSTGRES_PORT=5442
REDIS_PORT=6389

# No network or paid credentials used by the default voice/planner.
VOICE_PROVIDER=mock
LIVE_CALLS_ENABLED=false
MOCK_LATENCY_MS=150
PROVIDER_TIMEOUT_MS=10000
RETENTION_DAYS=30
SESSION_TTL_HOURS=24

# Optional live server configuration: uncomment and supply your authorized setup.
# Set VOICE_PROVIDER=sarvam and LIVE_CALLS_ENABLED=true only after setup/review.
# Sarvam Voice Agents / Samvaad key (telephony, live phone calls)
# SARVAM_SAMVAAD_API_KEY=replace-with-samvaad-workspace-key
# SARVAM_API_KEY=replace-with-samvaad-workspace-key
# SARVAM_ORG_ID=replace-with-organization-id
# SARVAM_WORKSPACE_ID=replace-with-workspace-id
# SARVAM_APP_ID=replace-with-committed-agent-app-id
# SARVAM_APP_VERSION=1
# SARVAM_CONNECTION_ID=replace-with-telephony-connection-id
# SARVAM_AGENT_PHONE_NUMBER=replace-with-authorized-E164-caller
# SARVAM_WEBHOOK_BASE_URL=https://your-authorized-ingress.example
# SARVAM_WEBHOOK_TOKEN=replace-with-random-32-byte-base64url-token
# SARVAM_WEBHOOK_FALLBACK_ACKNOWLEDGED=true
# LIVE_DESTINATION_ALLOWLIST=replace-with-authorized-E164-test-destinations

# Sarvam Developer Subscription API Key (TTS voice preview, Bulbul voices, LLMs)
# SARVAM_MODEL_API_KEY=replace-with-dashboard-sarvam-api-key

# Optional host development and acceptance addresses.
# API_PROXY_TARGET=http://localhost:3000
# API_INTERNAL_URL=http://localhost:3000
# API_URL=http://localhost:3000
# WEB_URL=http://localhost:5173

# Real Model Configuration (Anthropic / OpenAI / OpenAI-Compatible Provider)
MODEL_PROVIDER=openai
# MODEL_PROVIDER=anthropic
# ANTHROPIC_API_KEY=your-anthropic-or-relay-api-key
# ANTHROPIC_BASE_URL=https://api.anthropic.com
# ANTHROPIC_MODEL=claude-3-5-haiku-20241022
# ANTHROPIC_VERSION=2023-06-01

OPENAI_API_KEY=your-openai-api-key-here
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
MODEL_TIMEOUT_MS=15000

# Optional OpenAI-compatible alternate variable names
OPENAI_COMPATIBLE_API_KEY=your-openai-api-key-here
OPENAI_COMPATIBLE_BASE_URL=https://api.openai.com/v1
OPENAI_COMPATIBLE_MODEL_ID=gpt-4o-mini

# Optional official Sarvam model & voice preview SDK (uses SARVAM_API_KEY from above).
SARVAM_MODEL_NAME=sarvam-105b
# SARVAM_API_KEY=replace-with-authorized-sarvam-api-key
